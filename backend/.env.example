# MongoDB
MONGO_URL=mongodb://mongo:PASSWORD@HOST:PORT
PORT=5000

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# FreshBooks OAuth2
# Get CLIENT_ID / CLIENT_SECRET from: https://my.freshbooks.com/#/developer
# Put the REAL values in backend/.env (git-ignored), NOT here in .env.example.
# REDIRECT_URI must EXACTLY match the one registered on the FreshBooks app AND
# must point at the callback route, e.g.
#   local: http://localhost:5000/auth/freshbooks/callback
#   prod : https://www.101quiet.work/auth/freshbooks/callback
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REDIRECT_URI=

# FreshBooks Tokens (OPTIONAL)
# Easiest: start the server and open  /auth/freshbooks  -> Connect -> Allow.
# The callback saves tokens to MongoDB automatically and refreshes them after that.
# Only set these to seed tokens manually (via `node freshbooks-auth.js`).
FRESHBOOKS_ACCESS_TOKEN=
FRESHBOOKS_REFRESH_TOKEN=

# FreshBooks Account
# Found in your FreshBooks dashboard URL: my.freshbooks.com/accounting/account/{ACCOUNT_ID}/...
FRESHBOOKS_ACCOUNT_ID=
