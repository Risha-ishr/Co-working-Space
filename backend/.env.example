# MongoDB
MONGO_URL=mongodb://mongo:PASSWORD@HOST:PORT
PORT=5000

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# FreshBooks OAuth2
# Get these from: https://my.freshbooks.com/#/developer
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REDIRECT_URI=

# FreshBooks Tokens
# Access token + refresh token are obtained after the OAuth2 authorization flow
FRESHBOOKS_ACCESS_TOKEN=
FRESHBOOKS_REFRESH_TOKEN=

# FreshBooks Account
# Found in your FreshBooks dashboard URL: my.freshbooks.com/accounting/account/{ACCOUNT_ID}/...
FRESHBOOKS_ACCOUNT_ID=
